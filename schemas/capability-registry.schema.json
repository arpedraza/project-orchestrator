{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-orchestrator/capability-registry.schema.json",
  "title": "Project Orchestrator Capability Registry",
  "type": "object",
  "required": ["schema_version", "providers", "specialists", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string"},
    "providers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "specialists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["specialist_id", "provider", "identity", "roles", "capabilities", "trust", "health", "validation_level", "runtime_status", "eligibility", "findings"],
        "properties": {
          "specialist_id": {"type": "string"},
          "provider": {"type": "string"},
          "package_path": {"type": "string"},
          "identity": {"type": "object"},
          "roles": {"type": "array"},
          "capabilities": {"type": "array"},
          "trust": {"type": "object"},
          "health": {"enum": ["AVAILABLE", "DEGRADED", "UNAVAILABLE", "QUARANTINED"]},
          "validation_level": {"enum": ["STATIC"]},
          "runtime_status": {"enum": ["NOT_EVALUATED", "AVAILABLE", "DEGRADED", "UNAVAILABLE"]},
          "eligibility": {"const": "NOT_EVALUATED"},
          "findings": {"type": "array"}
        }
      }
    },
    "summary": {"type": "object"}
  }
}
