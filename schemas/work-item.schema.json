{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-item.schema.json",
  "title": "Project Orchestrator v2 Work Item",
  "$defs": {
    "duration": {"type": "object", "required": ["value", "unit"], "additionalProperties": false, "properties": {"value": {"type": "number", "minimum": 0}, "unit": {"enum": ["minutes", "hours", "days"]}}},
    "dates": {"type": "object", "additionalProperties": false, "properties": {"start": {"type": ["string", "null"], "format": "date-time"}, "finish": {"type": ["string", "null"], "format": "date-time"}}},
    "acceptanceCriterion": {"type": "object", "required": ["id", "description", "required", "status"], "additionalProperties": true, "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "status": {"enum": ["PENDING", "SATISFIED", "FAILED"]}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
  },
  "type": "object",
  "required": ["id", "type", "title", "objective", "reporting_stage", "state", "priority"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1},
    "parent_ref": {"type": ["string", "null"], "minLength": 1}, "reporting_stage": {"type": "string", "minLength": 1},
    "state": {"enum": ["PROPOSED", "READY", "IN_PROGRESS", "NEEDS_REVIEW", "WAITING", "NEEDS_REWORK", "BLOCKED", "NEEDS_DECISION", "DONE", "PARKED", "CANCELLED", "SUPERSEDED"]},
    "priority": {"type": "string", "minLength": 1},
    "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}}, "preferred_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "executor": {"type": ["object", "null"], "required": ["type", "id"], "additionalProperties": true, "properties": {"type": {"enum": ["human", "agent", "automation", "external"]}, "id": {"type": "string", "minLength": 1}}},
    "environment_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "release_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}, "required_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "items": {"$ref": "#/$defs/acceptanceCriterion"}}, "traceability_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "output_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "schedule": {"type": ["object", "null"], "additionalProperties": true, "properties": {"estimate": {"$ref": "#/$defs/duration"}, "baseline": {"$ref": "#/$defs/dates"}, "forecast": {"$ref": "#/$defs/dates"}, "actual": {"$ref": "#/$defs/dates"}}}
  }
}
