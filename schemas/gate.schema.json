{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate.schema.json",
  "title": "Project Orchestrator v2 Gate",
  "$defs": {"criterion": {"type": "object", "required": ["id", "description", "required", "status"], "additionalProperties": true, "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "status": {"enum": ["NOT_EVALUATED", "SATISFIED", "FAILED", "WAIVED"]}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "decision_ref": {"type": ["string", "null"], "minLength": 1}}}},
  "type": "object",
  "required": ["id", "name", "category", "scope", "blocking", "status", "validity"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "scope": {"type": "object"}, "blocking": {"type": "boolean"},
    "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}}, "required_evaluator_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "approval_policy_ref": {"type": ["string", "null"], "minLength": 1}, "status": {"enum": ["NOT_READY", "READY", "EVALUATING", "PASSED", "FAILED", "WAIVED"]},
    "validity": {"enum": ["VALID", "STALE", "INVALIDATED"]}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "decision_ref": {"type": ["string", "null"], "minLength": 1}
  }
}
